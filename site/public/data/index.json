on","bytes":9012,"sha1":"cbd7fdef0fbb"},{"path":"fichas/mig_life.json","bytes":7554,"sha1":"2af3edd62222"},{"path":"fichas/neet.json","bytes":7342,"sha1":"07d8458e1b01"},{"path":"fichas/ocup_dist.json","bytes":10419,"sha1":"a7ebb55e80b7"},{"path":"fichas/pension.json","bytes":7270,"sha1":"7242b24a73b3"},{"path":"fichas/secondary_job.json","bytes":7236,"sha1":"28c8ba71f7b4"},{"path":"fichas/sector_dist.json","bytes":9619,"sha1":"6016b4e7228f"},{"path":"fichas/seguro.json","bytes":8058,"sha1":"fd7262d078ad"},{"path":"fichas/seguro_contrib.json","bytes":7698,"sha1":"b84fca296b83"},{"path":"fichas/self_emp.json","bytes":7195,"sha1":"d3e222acd4aa"},{"path":"fichas/sis.json","bytes":7161,"sha1":"500fd1ba92d7"},{"path":"fichas/status_dist.json","bytes":7021,"sha1":"3917e0d19bc6"},{"path":"fichas/subemp_hours.json","bytes":7855,"sha1":"6517bdbce50a"},{"path":"fichas/subemp_income.json","bytes":10262,"sha1":"eac3aaa185fc"},{"path":"fichas/tfnr.json","bytes":7152,"sha1":"ccd870785630"},{"path":"fichas/ur.json","bytes":6840,"sha1":"8f8856cfd96f"},{"path":"fichas/ur_ext.json","bytes":6996,"sha1":"1dffaccde27a"},{"path":"fichas/ur_youth.json","bytes":6806,"sha1":"3f4ed2049857"},{"path":"fichas/working_poor.json","bytes":7193,"sha1":"4779419ae47b"}],"n_files":136,"glossary":[{"term":"PET","def":"Población en edad de trabajar: personas de 14 años o más (convención INEI)."},{"term":"PEA","def":"Población económicamente activa: ocupados más desocupados abiertos (buscaron trabajo la semana de referencia)."},{"term":"Tasa de actividad","def":"PEA dividida entre la PET. Mide cuántos participan, no cuántos tienen buen empleo."},{"term":"Tasa de desempleo","def":"Desocupados abiertos entre la PEA. En el Perú es baja porque sin seguro de desempleo la gente se autoemplea."},{"term":"Empleo informal","def":"Definición INEI/OIT: trabajar en una unidad no registrada en SUNAT, o como asalariado sin seguro de salud ni pensión ligados al empleo, o como familiar no remunerado."},{"term":"Empleo adecuado","def":"Ocupado sin subempleo por horas (quiere y puede trabajar más) ni por ingresos (gana menos que la remuneración mínima)."},{"term":"Sello de confiabilidad","def":"Resumen de la precisión: Sólido (error relativo < 15 %), Cautela (15–30 %), Suprimido (≥ 30 % o menos de 30 casos)."},{"term":"Error estándar de diseño","def":"Incertidumbre que reconoce que la ENAHO muestrea conglomerados y estratos, no personas al azar; se calcula por linealización de Taylor."},{"term":"IC 95 %","def":"Intervalo de confianza: rango que contendría el valor verdadero en 95 de cada 100 muestras."},{"term":"Brecha ajustada","def":"Diferencia entre grupos después de comparar personas con la misma edad, educación, región, etc. (modelo con controles)."},{"term":"Oaxaca–Blinder","def":"Descomposición de una brecha en la parte explicada por características distintas y la parte no explicada (retornos distintos a las mismas características)."},{"term":"Shift-share","def":"Descomposición de un cambio en el tiempo entre cambio de composición (quién trabaja dónde) y cambio de tasas dentro de cada grupo."},{"term":"Migrante reciente","def":"Persona que hace cinco años vivía en otro departamento o país (ENAHO, módulo 400)."},{"term":"Migración de toda la vida","def":"Persona cuya madre vivía en otro departamento cuando nació (pregunta disponible desde 2018)."},{"term":"Saldo migratorio neto","def":"Inmigrantes menos emigrantes de un departamento, por cada mil habitantes."},{"term":"Factor de expansión","def":"Peso que convierte cada persona entrevistada en el número de personas que representa (fac500a, facpob07, factor07)."},{"term":"Desempleo oculto","def":"Personas sin empleo que querrían trabajar y están disponibles, pero no buscaron trabajo. INEI las cuenta como inactivas; la tasa ampliada las suma al desempleo abierto."},{"term":"Trabajadores pobres","def":"Ocupados que viven en un hogar bajo la línea de pobreza monetaria: tener empleo no saca de la pobreza."},{"term":"Seguro contributivo","def":"Seguro de salud que se financia con aportes ligados al empleo o al bolsillo (EsSalud, EPS, privado, FF.AA./PNP), a diferencia del SIS, que es subsidiado."},{"term":"Índice de Gini","def":"Medida de desigualdad entre 0 (todos ganan lo mismo) y 1 (una persona concentra todo el ingreso). Aquí se calcula sobre el ingreso laboral de los ocupados con ingreso."},{"term":"Brecha no concluyente","def":"Brecha cuyo intervalo de confianza de 95 % incluye la ausencia de brecha: con estos datos no se puede afirmar que exista. Se marca «n.c.»."}],"faq":[{"q":"¿Por qué la tasa de desempleo aquí (4,7 %) no coincide con la que sale en prensa (5,6 %)?","a":"La cifra de prensa proviene de la EPEN (Encuesta Permanente de Empleo Nacional), una encuesta distinta. Este observatorio usa la ENAHO anual, cuya serie oficial de INEI coincide con la nuestra en ±0,1 pp."},{"q":"¿Puedo citar una cifra con sello Cautela?","a":"Sí, siempre con su intervalo de confianza. Una cifra Cautela tiene un error relativo de 15–30 %; su intervalo es ancho y las comparaciones con ella suelen no ser concluyentes."},{"q":"¿Por qué algunas celdas dicen — ?","a":"Están suprimidas: menos de 30 observaciones o error relativo mayor a 30 %. Publicarlas induciría a error."},{"q":"¿Los datos son oficiales?","a":"Los microdatos sí (INEI). Las estimaciones son del Observatorio, con definiciones INEI/OIT y validadas contra tablas oficiales; ver Metodología → Validación."},{"q":"¿Cómo descargo todo?","a":"En /datos/: JSON por página, CSV por tabla (T01…), diccionario de variables y un índice machine-readable (/data/index.json)."},{"q":"¿Puedo insertar un gráfico en mi web o informe?","a":"Sí: cada gráfico tiene botones CSV/SVG/PNG y muchas páginas ofrecen un snippet <iframe>. Licencia CC BY 4.0: cita al Observatorio."},{"q":"¿Cómo se actualiza?","a":"Cuando INEI publica la ENAHO anual (mayo) se reejecuta el pipeline completo; la fecha de generación aparece en el pie y en meta.json."}]}