---
import Base from '../../layouts/Base.astro';
import CompendiumTable from '../../components/charts/CompendiumTable';
import { loadCompendiumIndex } from '../../data/loaders';
const idx = loadCompendiumIndex();
const bySection = Object.entries(idx.sections).map(([n, title]) => ({ n: +n, title, tables: idx.tables.filter((t: any) => t.section === +n) }));
---
<Base title="Compendio estadístico" wide>
  <h1 style="margin-top:32px">Compendio estadístico</h1>
  <p class="lede">{idx.tables.length} tablas con estimación, error estándar, intervalo de 95%, n y sello. Abre una tabla para verla o descarga su CSV, listo para R, Stata o Python.</p>
  <input id="c-find" class="c-find" type="search" placeholder="Buscar tabla, por ejemplo: rama, lengua, ingreso" aria-label="Buscar en el compendio" />
  <p id="c-none" class="muted" hidden>Ninguna tabla coincide con esa búsqueda.</p>
  {bySection.map(s => <section class="c-sec" style="margin-top:26px"><h2>{s.title}</h2>{s.tables.map((t: any) => <details class="c-tab" id={t.id} data-q={`${t.id} ${t.title} ${s.title}`.toLowerCase()}><summary><span class="id">{t.id}</span><span>{t.title}</span><a href={`/data/${t.file}`} download>CSV</a></summary><CompendiumTable client:visible file={t.file} title={t.title} id={t.id} /></details>)}</section>)}
  <script>
    const input = document.getElementById('c-find') as HTMLInputElement, none = document.getElementById('c-none')!;
    const tabs = [...document.querySelectorAll<HTMLDetailsElement>('.c-tab')], secs = [...document.querySelectorAll<HTMLElement>('.c-sec')];
    const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
    input.addEventListener('input', () => { const q = norm(input.value.trim()); tabs.forEach(t => t.hidden = !norm(t.dataset.q!).includes(q)); secs.forEach(s => s.hidden = !s.querySelector('.c-tab:not([hidden])')); none.hidden = tabs.some(t => !t.hidden); });
    const open = () => { const t = location.hash && document.getElementById(location.hash.slice(1)); if (t instanceof HTMLDetailsElement) { t.open = true; t.scrollIntoView(); } };
    open(); addEventListener('hashchange', open);
    document.querySelectorAll('.c-tab summary a').forEach(a => a.addEventListener('click', e => e.stopPropagation()));
  </script>
</Base>
