---
import Base from '../../../layouts/Base.astro';
import HowToRead from '../../../components/ui/HowToRead.astro';
import ScrollyScene from '../../../components/charts/ScrollyScene';
import AtlasMap from '../../../components/charts/AtlasMap';
import { loadHeadline, loadAtlas, loadTrends } from '../../../data/loaders';
const h = loadHeadline(); const a = loadAtlas(); const tr = loadTrends();
const k = h.kpis; const d = h.deltas;
const f = (c: any, n = 1) => c?.v == null ? '—' : c.v.toLocaleString('es-PE', { minimumFractionDigits: n, maximumFractionDigits: n });
const last = (dom: string, ind: string, key: string) => tr.series[dom][ind][key].at(-1);
const first = (dom: string, ind: string, key: string) => tr.series[dom][ind][key][0];
const sx = (i: string, k2: string) => last('sex', i, k2), ag = (i: string, k2: string) => last('age4', i, k2), lg = (i: string, k2: string) => last('lengua3', i, k2), et = (i: string, k2: string) => last('etnia6', i, k2), ar = (i: string, k2: string) => last('area', i, k2), ed = (i: string, k2: string) => last('educ4', i, k2), rn = (i: string, k2: string) => last('region_nat', i, k2), se = (i: string, k2: string) => last('sex_educ4', i, k2);
const nat = (ind: string) => tr.series.national[ind].map((c: any) => c.v);
const depts = a.regions.filter(r => !r.parent);
const sortBy = (dim: string, asc = true) => [...depts].filter(r => r.values[dim].v != null).sort((x, y) => ((x.values[dim].v ?? 0) - (y.values[dim].v ?? 0)) * (asc ? 1 : -1));
const fLow = sortBy('formality')[0], fHigh = sortBy('formality', false)[0], iLow = sortBy('median_inc_real')[0], iHigh = sortBy('median_inc_real', false)[0], gHigh = sortBy('gap_lfpr', false)[0], gLow = sortBy('gap_lfpr')[0];
const dl = (x: any) => x ? `${x.d > 0 ? '+' : ''}${x.d.toLocaleString('es-PE', { maximumFractionDigits: 1 })}` : '—';
const sig = (x: any) => x?.sig ? '' : ' (no significativo)';
const steps = [
  { id: 'step-titulares', title: 'Los titulares tranquilizan', html: `<p>En 2024, <strong>${f(k.lfpr)} %</strong> de los peruanos de 14 años o más trabaja o busca trabajo, y sólo <strong>${f(k.ur)} %</strong> de esa fuerza laboral no encuentra empleo. Frente a 2023 el desempleo cambió ${dl(d.ur.d1)} pp${sig(d.ur.d1)}; frente a 2014, ${dl(d.ur.d10)} pp${sig(d.ur.d10)}. Con esos números el Perú parecería un país de pleno empleo.</p><p>La primera pista de que la historia es otra está en el campo: la participación rural (${f(ar('lfpr', '2'))} %) supera a la urbana (${f(ar('lfpr', '1'))} %) y el desempleo rural es de apenas ${f(ar('ur', '2'))} % contra ${f(ar('ur', '1'))} % urbano. Donde no hay seguro de desempleo ni ahorros, no trabajar no es una opción. El desempleo bajo mide la falta de alternativas, no la abundancia de buenos empleos.</p><p class="small muted">Compendio: T01, T03.</p>`,
    chart: { type: 'kpis', title: 'Indicadores titulares 2024', items: [{ key: 'lfpr', v: k.lfpr.v, label: 'Tasa de actividad', color: 1 }, { key: 'epr', v: k.epr.v, label: 'Empleo / población', color: 1 }, { key: 'ur', v: k.ur.v, label: 'Desempleo', color: 0 }], annotations: [{ key: 'ur', text: 'Bajo por falta de alternativas, no por abundancia de empleo', dx: -40, dy: -70 }], note: `ENAHO 2024, ${h.n_persons.toLocaleString('es-PE')} personas de 14+ años. Sellos: Sólido en las tres cifras.` } },
  { id: 'step-informalidad', title: `La cifra que importa: ${Math.round(k.informality.v ?? 0)} de cada 100`, html: `<p><strong>${f(k.informality)} %</strong> de los ocupados tiene empleo informal: trabaja en una unidad no registrada en SUNAT, o como asalariado sin seguro de salud ni pensión ligados al empleo, o como familiar no remunerado. En el campo la informalidad es casi universal (<strong>${f(ar('informality', '2'))} %</strong>); en las ciudades, ${f(ar('informality', '1'))} %.</p><p>La consecuencia es que sólo <strong>${f(k.adecuado)} %</strong> tiene un empleo adecuado —sin subempleo por horas ni por ingresos— y ${f(h.protection.subemp_income)} % gana menos que la remuneración mínima. Sólo ${f(h.protection.pension)} % de los ocupados aporta a una pensión y ${f(h.protection.contract_any)} % de los asalariados tiene contrato.</p><p class="small muted">Compendio: T16, T28, T31.</p>`,
    chart: { type: 'bars', title: 'Protección de los ocupados, 2024 (%)', unit: '%', items: [{ key: 'informality', label: 'Empleo informal', v: k.informality.v, color: 0 }, { key: 'inf_rural', label: 'Informal · rural', v: ar('informality', '2').v, color: 0 }, { key: 'inf_urb', label: 'Informal · urbano', v: ar('informality', '1').v, color: 0 }, { key: 'pension', label: 'Con pensión', v: h.protection.pension.v, color: 1 }, { key: 'contract', label: 'Asalariados con contrato', v: h.protection.contract_any.v, color: 1 }, { key: 'adecuado', label: 'Empleo adecuado', v: k.adecuado.v, color: 1 }], annotations: [{ key: 'inf_rural', text: 'En el campo la informalidad es casi universal', dx: -120, dy: -26 }], note: 'Carmín: desprotección. Jade: protección.' } },
  { id: 'step-genero', title: 'La brecha de género empieza antes del empleo', html: `<p>Los hombres participan <strong>${f(k.gap_lfpr)} puntos</strong> más que las mujeres (${f(sx('lfpr', '1'))} % vs ${f(sx('lfpr', '2'))} %). Es una brecha de entrada: el trabajo de cuidados no remunerado no cuenta como empleo. Las mujeres que sí participan enfrentan más desempleo (${f(sx('ur', '2'))} % vs ${f(sx('ur', '1'))} %), más informalidad (${f(sx('informality', '2'))} % vs ${f(sx('informality', '1'))} %) y un ingreso mediano de S/ ${f(sx('median_inc_real', '2'), 0)} frente a S/ ${f(sx('median_inc_real', '1'), 0)}: <strong>${f({ v: 100 * sx('median_inc_real', '2').v / sx('median_inc_real', '1').v }, 0)} centavos por cada sol</strong>.</p><p>Desde 2014 la brecha de participación cambió ${dl(d.gap_lfpr.d10)} pp${sig(d.gap_lfpr.d10)}. Diez años, casi nada.</p><p class="small muted">Compendio: T02, T08, T35.</p>`,
    chart: { type: 'bars', title: 'Mujeres y hombres, 2024 (%)', items: [{ label: 'Actividad · hombres', v: sx('lfpr', '1').v, color: 1 }, { label: 'Actividad · mujeres', v: sx('lfpr', '2').v, color: 0 }, { label: 'Desempleo · hombres', v: sx('ur', '1').v, color: 1 }, { label: 'Desempleo · mujeres', v: sx('ur', '2').v, color: 0 }, { label: 'Informalidad · hombres', v: sx('informality', '1').v, color: 1 }, { label: 'Informalidad · mujeres', v: sx('informality', '2').v, color: 0 }] } },
  { id: 'step-educacion', title: 'La paradoja educativa', html: `<p>Estudiar protege de la informalidad: cae de <strong>${f(ed('informality', '1'))} %</strong> entre quienes tienen hasta primaria a <strong>${f(ed('informality', '4'))} %</strong> entre universitarios, y el ingreso mediano se multiplica de S/ ${f(ed('median_inc_real', '1'), 0)} a S/ ${f(ed('median_inc_real', '4'), 0)}.</p><p>Pero estudiar no protege del desempleo: es más alto entre universitarios (${f(ed('ur', '4'))} %) que entre quienes sólo tienen primaria (${f(ed('ur', '1'))} %), y entre las mujeres universitarias llega a <strong>${f(se('ur', '2|4'))} %</strong> frente a ${f(se('ur', '1|4'))} % de los hombres con el mismo nivel. Quien tiene educación puede permitirse buscar un empleo a su altura; quien no la tiene acepta lo que hay. El desempleo, en el Perú, es un lujo.</p><p class="small muted">Compendio: T09, T10, T11.</p>`,
    chart: { type: 'bars', title: 'Por nivel educativo, 2024 (%)', items: [{ label: 'Informalidad · primaria', v: ed('informality', '1').v, color: 0 }, { label: 'Informalidad · secundaria', v: ed('informality', '2').v, color: 0 }, { label: 'Informalidad · sup. no univ.', v: ed('informality', '3').v, color: 0 }, { label: 'Informalidad · universitaria', v: ed('informality', '4').v, color: 0 }, { label: 'Desempleo · primaria', v: ed('ur', '1').v, color: 1 }, { label: 'Desempleo · universitaria', v: ed('ur', '4').v, color: 1 }, { label: 'Desempleo · mujeres universitarias', v: se('ur', '2|4').v, color: 1 }] } },
  { id: 'step-jovenes', title: 'Los jóvenes entran por la puerta informal', html: `<p>Entre los 14 y 24 años el desempleo es de <strong>${f(ag('ur', '1'))} %</strong> —más del doble del promedio— y la informalidad de <strong>${f(ag('informality', '1'))} %</strong>. Uno de cada cinco jóvenes de 15 a 29 años ni estudia ni trabaja (<strong>${f(k.neet)} %</strong>).</p><p>A los 25–44 años el desempleo baja a ${f(ag('ur', '2'))} % y la actividad sube a ${f(ag('lfpr', '2'))} %: la exclusión del empleo es transitoria. La informalidad no: a los 65 años o más vuelve a ${f(ag('informality', '4'))} %, porque sin pensión el trabajo no termina.</p><p class="small muted">Compendio: T05, T06.</p>`,
    chart: { type: 'bars', title: 'Por grupo de edad, 2024 (%)', items: [{ label: 'Desempleo 14–24', v: ag('ur', '1').v, color: 1 }, { label: 'Desempleo 25–44', v: ag('ur', '2').v, color: 1 }, { label: 'Desempleo 45–64', v: ag('ur', '3').v, color: 1 }, { label: 'Informalidad 14–24', v: ag('informality', '1').v, color: 0 }, { label: 'Informalidad 25–44', v: ag('informality', '2').v, color: 0 }, { label: 'Informalidad 45–64', v: ag('informality', '3').v, color: 0 }, { label: 'Informalidad 65+', v: ag('informality', '4').v, color: 0 }] } },
  { id: 'step-lengua', title: 'Lengua materna y etnicidad: la estratificación silenciosa', html: `<p>Quienes aprendieron una lengua indígena u originaria en la niñez participan más (${f(lg('lfpr', '1'))} % vs ${f(lg('lfpr', '2'))} %) y casi siempre en la informalidad: <strong>${f(lg('informality', '1'))} %</strong> frente a ${f(lg('informality', '2'))} % de quienes aprendieron castellano. Su ingreso mediano es de S/ ${f(lg('median_inc_real', '1'), 0)} contra S/ ${f(lg('median_inc_real', '2'), 0)}.</p><p>Por autoidentificación el orden se repite: ${f(et('informality', '5'))} % de informalidad entre quienes se consideran blancos o mestizos, ${f(et('informality', '4'))} % entre afroperuanos, ${f(et('informality', '1'))} % entre quechuas, ${f(et('informality', '2'))} % entre aimaras y ${f(et('informality', '3'))} % entre nativos amazónicos u otros pueblos indígenas. Parte de esta brecha es geográfica (sierra y selva rural), pero no toda: persiste dentro de las ciudades.</p><p class="small muted">Compendio: T21–T25.</p>`,
    chart: { type: 'bars', title: 'Informalidad por lengua materna y etnicidad, 2024 (%)', items: [{ label: 'Lengua indígena', v: lg('informality', '1').v, color: 0 }, { label: 'Castellano', v: lg('informality', '2').v, color: 1 }, { label: 'Quechua', v: et('informality', '1').v, color: 0 }, { label: 'Aimara', v: et('informality', '2').v, color: 0 }, { label: 'Amazónico / otro indígena', v: et('informality', '3').v, color: 0 }, { label: 'Afroperuano', v: et('informality', '4').v, color: 0 }, { label: 'Blanco / mestizo', v: et('informality', '5').v, color: 1 }] } },
  { id: 'step-territorio', title: 'Tres países en uno', html: `<p>Lima Metropolitana tiene ${f(rn('informality', '4'))} % de informalidad e ingreso mediano de S/ ${f(rn('median_inc_real', '4'), 0)}; la costa, ${f(rn('informality', '1'))} % y S/ ${f(rn('median_inc_real', '1'), 0)}; la sierra, ${f(rn('informality', '2'))} % y S/ ${f(rn('median_inc_real', '2'), 0)}; la selva, ${f(rn('informality', '3'))} % y S/ ${f(rn('median_inc_real', '3'), 0)}.</p><p>Entre departamentos la distancia es aún mayor: la informalidad va de <strong>${f({ v: 100 - fHigh.values.formality.v! })} % en ${fHigh.name}</strong> a <strong>${f({ v: 100 - fLow.values.formality.v! })} % en ${fLow.name}</strong>; el ingreso mediano, de S/ ${f(iHigh.values.median_inc_real, 0)} en ${iHigh.name} a S/ ${f(iLow.values.median_inc_real, 0)} en ${iLow.name}. La brecha de género de participación es de ${f(gHigh.values.gap_lfpr)} puntos en ${gHigh.name} y de ${f(gLow.values.gap_lfpr)} en ${gLow.name}.</p><p class="small muted">Compendio: T04, T17.</p>`,
    chart: { type: 'bars', title: 'Informalidad por región natural, 2024 (%)', items: [{ label: 'Lima Metropolitana', v: rn('informality', '4').v, color: 1 }, { label: 'Costa', v: rn('informality', '1').v, color: 0 }, { label: 'Sierra', v: rn('informality', '2').v, color: 0 }, { label: 'Selva', v: rn('informality', '3').v, color: 0 }, { label: `${fHigh.name} (mín.)`, v: 100 - fHigh.values.formality.v!, color: 1 }, { label: `${fLow.name} (máx.)`, v: 100 - fLow.values.formality.v!, color: 0 }] } },
  { id: 'step-mapa', title: 'La geografía pesa más que cualquier otra variable', html: `<p>La informalidad va de <strong>${f({ v: 100 - fHigh.values.formality.v! })} % en ${fHigh.name}</strong> a <strong>${f({ v: 100 - fLow.values.formality.v! })} % en ${fLow.name}</strong>. Lima Metropolitana, Arequipa, Ica y Moquegua son islas de formalidad relativa; la sierra sur y la selva concentran el empleo desprotegido. Ningún grupo social —sexo, edad, lengua— separa tanto como el lugar de residencia.</p><p class="small muted">Compendio: T17. Atlas: <a href="/atlas/">mapa interactivo</a>.</p>`,
    chart: { type: 'map', title: 'Informalidad por departamento, 2024 (%)', unit: '%', higherBetter: false, items: depts.map(r => ({ key: r.id, label: r.name, v: r.values.formality.v == null ? null : 100 - r.values.formality.v, highlight: r.id === fHigh.id || r.id === fLow.id, color: r.id === fHigh.id ? 1 : 0 })), note: 'Más oscuro = más informal. Puntos: mínimo y máximo.' } },
  { id: 'step-decada', title: 'Una década sin salida', html: `<p>Entre 2014 y 2024 la informalidad pasó de ${f(h.trend.informality[0])} % a ${f(k.informality)} % (${dl(d.informality.d10)} pp${sig(d.informality.d10)}). Bajó lentamente hasta 2019, saltó con la pandemia de 2020 y desde entonces sólo ha regresado al punto de partida. El ingreso mediano real cambió S/ ${dl(d.median_inc_real.d10)}${sig(d.median_inc_real.d10)}: una década de crecimiento que no llegó al trabajador mediano.</p><p>La lección del observatorio es simple: el desempleo no es el termómetro del mercado laboral peruano. Lo son la informalidad, el subempleo y el ingreso mediano. Y esos tres, en diez años, casi no se movieron.</p><p class="small muted">Compendio: T34, T36. Metodología: la cifra 2024 de informalidad usa la regla del Observatorio.</p>`,
    chart: { type: 'lines', title: 'Informalidad, empleo adecuado y desempleo, 2014–2024 (%)', years: h.years, series: [{ label: 'Informalidad', values: nat('informality') }, { label: 'Empleo adecuado', values: nat('adecuado') }, { label: 'Desempleo', values: nat('ur') }], note: '2020: pandemia; 2024: informalidad estimada con la regla del Observatorio.' } },
];
---
<Base title="El empleo no es seguridad" wide>
  <div class="eyebrow" style="margin-top:28px">Historia · ENAHO 2024 · ocho capítulos</div>
  <h1>El empleo <em>no es</em> seguridad</h1>
  <p class="lede">Un recorrido por el mercado laboral peruano, de los titulares que tranquilizan a las brechas que los promedios esconden. Cada cifra lleva su tabla del compendio.</p>
  <HowToRead />
  <ScrollyScene client:load steps={steps} mapNames={Object.fromEntries(a.regions.map(r => [r.id, r.name]))} />
  <section class="card" style="margin-top:32px"><div class="eyebrow">Epílogo</div><h2>El mapa: dónde el trabajo protege</h2><p class="takeaway">La geografía pesa más que cualquier otra variable. Explora la formalidad y abre el perfil de cada departamento.</p><AtlasMap client:visible regions={a.regions} dims={a.dims} year={a.year} initial="formality" /></section>
  <p style="margin-top:24px"><a class="btn primary" href="/historias/panorama-2024/informe-completo/">Ver el informe completo (42 tablas)</a> <a class="btn" href="/acerca/metodologia/">Metodología</a></p>
</Base>
