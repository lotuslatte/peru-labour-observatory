---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../../layouts/Base.astro';
import '../../styles/redesign.css';
import { fmtU } from '../../data/ui';
const idx = JSON.parse(fs.readFileSync(path.resolve(process.cwd(), 'public/data/fichas/index.json'), 'utf8'));
const value = (d: any) => d.latest?.v != null ? fmtU(d.latest.v, d.unit) : d.type === 'dist' ? 'Reparto' : 'Sin dato';
---
<Base title="Indicadores">
  <div class="r-page r-list">
    <section class="r-hero"><h1>Indicadores</h1><p class="r-src">{idx.indicators.length} indicadores, cada uno con su ficha: tendencia, grupos, cómo se mide, comparabilidad por año, descarga y cita. Valores de {idx.year}. Las tablas cruzadas están en el <a href="/compendio/">compendio</a>.</p></section>
    {idx.groups.map((g: string) => <section><h2>{g}</h2><ul>{idx.indicators.filter((d: any) => d.group === g).map((d: any) => <li><a href={`/indicadores/${d.id}/`}><span>{d.name}</span><span>{value(d)}</span></a></li>)}</ul></section>)}
  </div>
</Base>
