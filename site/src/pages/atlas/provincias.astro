---
import Base from '../../layouts/Base.astro';
import '../../styles/redesign.css';
import { loadProvinces } from '../../data/loaders';
const p = loadProvinces();
---
<Base title="Provincias" description={`Las ${p.n_regions} provincias del Perú en ENAHO ${p.years[0]}–${p.years.at(-1)}: mapa, comparación con el país, brechas y tipologías.`}>
  <div class="r-page">
    <header class="r-head">
      <h1>Las {p.n_regions} provincias del Perú</h1>
      <p class="r-say">Tres años de ENAHO agrupados ({p.years[0]}–{p.years.at(-1)}) para tener muestra en cada provincia.</p>
    </header>
    <div class="r-tabs" id="tabs" role="tablist"></div>
    <div id="view"><p class="r-src">Cargando datos…</p></div>
    <details class="r-details"><summary>Cómo leer estas cifras</summary>
      <p>{p.note} Las celdas con sello S quedan vacías y salen con trama en el mapa. La informalidad agrupa años medidos con dos métodos: <code>ocupinf</code> del INEI en 2023 y la regla del Observatorio desde 2024. Más detalle en <a href="/acerca/metodologia/">Metodología</a>.</p>
    </details>
    <noscript><p class="r-src">Esta página necesita JavaScript. Los datos están en <a href="/data/atlas_provincias.json">atlas_provincias.json</a>.</p></noscript>
  </div>
  <script src="../../scripts/provincias.js"></script>
</Base>
