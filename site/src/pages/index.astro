---
import { YEAR, PREV } from '../data/release';
import Base from '../layouts/Base.astro';
import '../styles/redesign.css';
import { loadHeadline, loadTrends } from '../data/loaders';
import { SIX, unitOf, fmtU } from '../data/ui';
const h = loadHeadline(); const tr = loadTrends();
const years: number[] = tr.years;
function spark(id: string) {
  const cells = tr.series.national[id]; const brk = tr.breaks.find((b: any) => b.indicators.includes(id));
  const vs = cells.filter((c: any) => c.v != null).map((c: any) => c.v), lo = Math.min(...vs), hi = Math.max(...vs);
  const X = (i: number) => 2 + i / (years.length - 1) * 196, Y = (v: number) => 32 - (v - lo) / ((hi - lo) || 1) * 28;
  const pts = cells.map((c: any, i: number) => c.v == null ? null : [X(i), Y(c.v), years[i]]);
  const groups: string[] = []; let cur: string[] = [];
  pts.forEach((p: any) => { if (!p) { if (cur.length) groups.push(cur.join(' ')); cur = []; return; } if (brk && p[2] === brk.year && cur.length) { groups.push(cur.join(' ')); cur = []; } cur.push(`${p[0]},${p[1]}`); });
  if (cur.length) groups.push(cur.join(' '));
  return { groups, end: [X(years.length - 1), Y(cells.at(-1).v)] };
}
function change(id: string) {
  const d = h.deltas[id].d1, u = unitOf(id);
  return d.sig ? `${d.d > 0 ? 'Sube' : 'Baja'} ${fmtU(Math.abs(d.d), u === 'S/' ? 'S/' : 'pp')} frente a ${PREV}` : `Sin cambio significativo frente a ${PREV}`;
}
---
<Base title="Inicio">
  <div class="r-page">
    <section class="r-hero">
      <h1>Trabajo en el Perú, {YEAR}</h1>
      <p class="r-src">ENAHO {YEAR} del INEI. {h.n_persons.toLocaleString('en-US')} personas de 14 años a más, en todo el país. Por <a href="https://lotuslatte.github.io/" rel="author">Favio Samillan Flores</a>.</p>
    </section>
    <section class="r-signals">
      {SIX.map(i => { const s = spark(i.id); return (
        <a class:list={['r-signal', { hot: i.id === 'informality' }]} href={`/indicadores/${i.id}/`}>
          <span class="num">{fmtU(tr.series.national[i.id].at(-1).v, unitOf(i.id))}</span>
          <span class="name">{i.name}</span><span class="what">{i.what}</span>
          <svg viewBox="0 0 200 36" aria-hidden="true">{s.groups.map(g => <polyline fill="none" stroke="var(--muted)" stroke-width="1.6" points={g} />)}<circle cx={s.end[0]} cy={s.end[1]} r="3" fill="var(--informal)" /></svg>
          <span class="chg">{change(i.id)}</span>
        </a>); })}
    </section>
    <div class="r-more"><a href="/indicadores/">Ver todos los indicadores</a><a href="/explorar/">Armar una consulta</a><a href="/historias/panorama/">Leer la historia {YEAR}</a></div>
  </div>
</Base>
