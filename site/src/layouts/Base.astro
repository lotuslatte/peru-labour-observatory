---
import { SPAN } from '../data/release';
import '../styles/global.css';
import Head from '../kit/ui/Head.astro';
import Nav from '../kit/ui/Nav.astro';
import Footer from '../kit/ui/Footer.astro';
import CommandPalette from '../kit/ui/CommandPalette';
import { SITE_NAME, NAV, FOOTER } from '../data/site';
interface Props { title: string; description?: string; wide?: boolean; image?: string; jsonLd?: object }
const { title, description = 'Observatorio abierto del mercado laboral peruano a partir de los microdatos de la ENAHO (INEI), ' + SPAN + '.', wide = false, image, jsonLd } = Astro.props;
---
<html lang="es">
  <head>
    <Head title={title} siteName={SITE_NAME} description={description} image={image} author="Favio Samillan Flores" authorUrl="https://lotuslatte.github.io/" jsonLd={jsonLd} />
  </head>
  <body>
    <a class="sr-only skip" href="#main">Saltar al contenido</a>
    <Nav name={SITE_NAME} items={NAV} />
    <main id="main" class={wide ? 'wrap wrap-wide' : 'wrap'}>
      <slot />
    </main>
    <Footer name={SITE_NAME} columns={FOOTER}>
      <Fragment slot="source">
        Fuente: INEI, Encuesta Nacional de Hogares (ENAHO) {SPAN}, módulo 500. Estimaciones con factor <code>fac500a</code> y errores estándar de diseño (linealización de Taylor). Licencia <a href="https://creativecommons.org/licenses/by/4.0/deed.es">CC BY 4.0</a>.
      </Fragment>
      <Fragment slot="credit">
        Creado por <a href="https://lotuslatte.github.io/" rel="author">Favio Samillan Flores</a>, economista (PUCP). <a href="https://www.linkedin.com/in/favio-samillan-flores-367054295/" rel="me">LinkedIn</a> · <a href="https://github.com/lotuslatte/peru-labour-observatory">Código en GitHub</a>
      </Fragment>
    </Footer>
    <CommandPalette client:idle src="/data/search.json" />
  </body>
</html>
